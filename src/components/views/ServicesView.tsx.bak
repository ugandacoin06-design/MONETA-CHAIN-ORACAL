              <p className="text-white font-medium text-xl">Every application has different data requirements.</p>
              <p className="text-slate-400 leading-relaxed text-lg">MONETA Oracle is not limited to one category of data. Developers and organizations can build specialized feeds around approved data sources and defined verification requirements.</p>
              
              <div className="grid grid-cols-2 md:grid-cols-4 gap-4 pt-4">
                {[
                  { title: 'CUSTOM PRICE FEEDS', desc: 'Application-specific market data.' },
                  { title: 'RWA FEEDS', desc: 'Data associated with real-world assets.' },
                  { title: 'EVENT FEEDS', desc: 'External events that need to become machine-readable.' },
                  { title: 'WEATHER FEEDS', desc: 'Environmental and weather information.' },
                  { title: 'SPORTS FEEDS', desc: 'Sports events and results.' },
                  { title: 'ENTERPRISE FEEDS', desc: 'Institutional and business information.' },
                  { title: 'CUSTOM DATA', desc: 'Purpose-built data feeds for specialized applications.' }
                ].map(item => (
                  <div key={item.title} className="p-4 bg-slate-900/30 border border-slate-800 rounded-lg">
                    <h4 className="font-bold text-white text-xs tracking-widest mb-2">{item.title}</h4>
                    <p className="text-slate-500 text-xs">{item.desc}</p>
                  </div>
                ))}
              </div>
            </section>

            {/* 10, 11 */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-12">
              {/* 10 */}
              <section className="space-y-6">
                <div className="flex items-center gap-4">
