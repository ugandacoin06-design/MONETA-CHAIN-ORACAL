          <div className="w-full h-px bg-slate-800/50"></div>

          {/* Final Statement / CTA */}
          <section className="text-center pt-16 pb-12">
            <h2 className="text-3xl md:text-5xl font-bold text-white tracking-tighter mb-8">
              THE ERA OF FRAGMENTED DATA IS ENDING.
