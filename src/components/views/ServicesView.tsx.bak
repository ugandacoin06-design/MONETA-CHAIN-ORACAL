            {/* 18 */}
            <section className="space-y-6 text-center py-12">
              <div className="flex items-center justify-center gap-4 mb-4">
                <span className="text-cyan-500 font-mono font-bold text-xl">18</span>
                <h3 className="text-2xl font-bold text-white tracking-widest uppercase">— THE FUTURE OF ORACLE INFRASTRUCTURE</h3>
              </div>
              
              <div className="max-w-3xl mx-auto space-y-6 text-slate-400 text-lg">
                <p className="text-xl text-white font-medium">The next generation of blockchain applications will require more than transactions. They will require access to information.</p>
                
                <div className="flex flex-wrap justify-center gap-3 font-mono text-sm tracking-widest uppercase text-cyan-400 py-4">
                  <span>Financial markets.</span>
                  <span>Real-world assets.</span>
                  <span>Artificial intelligence.</span>
                  <span>Physical-world events.</span>
                  <span>Enterprise systems.</span>
                  <span>Environmental data.</span>
                  <span>Global economic activity.</span>
