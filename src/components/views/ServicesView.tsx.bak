                    <h5 className="text-white font-bold mb-1">MONETA ECOSYSTEM</h5>
                    <p className="text-slate-400">Applications powered by both.</p>
                  </div>
                </div>
              </div>
            </section>

            {/* 13, 14 */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-12">
              {/* 13 */}
              <section className="space-y-6">
                <div className="flex items-center gap-4">
                  <span className="text-cyan-500 font-mono font-bold text-xl">13</span>
