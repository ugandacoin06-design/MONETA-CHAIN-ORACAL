                  <ArrowRight className="w-5 h-5 text-slate-700 rotate-90" />
                  <div className="text-cyan-400 border border-cyan-500/30 px-6 py-2 rounded-full bg-cyan-950/20">MONETA ORACLE</div>
                  <ArrowRight className="w-5 h-5 text-slate-700 rotate-90" />
                  <div className="text-white border border-slate-700 px-6 py-2 rounded-full">VERIFIED DATA LAYER</div>
                  <ArrowRight className="w-5 h-5 text-slate-700 rotate-90" />
                  <div className="text-white border border-slate-700 px-6 py-2 rounded-full">MONETA CHAIN</div>
                  <ArrowRight className="w-5 h-5 text-slate-700 rotate-90" />
                  <div className="text-slate-300">SMART CONTRACTS</div>
                  <ArrowRight className="w-5 h-5 text-slate-700 rotate-90" />
                  <div className="text-slate-500">APPLICATIONS</div>
