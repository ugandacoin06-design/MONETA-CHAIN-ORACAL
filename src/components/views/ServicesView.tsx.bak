                  { title: 'MULTI-CHAIN', desc: 'Built with multiple blockchain environments in mind.' },
                  { title: 'MODULAR', desc: 'Individual components can evolve without requiring the entire system to be redesigned.' },
                  { title: 'FLEXIBLE', desc: 'Pull, push, and hybrid delivery models can serve different applications.' },
                  { title: 'SCALABLE', desc: 'Aggregation and proof technologies can be used where they provide meaningful efficiency benefits.' },
                  { title: 'MONETA-NATIVE', desc: 'Designed to become an important data layer for MONETA CHAIN.' }
                ].map(item => (
